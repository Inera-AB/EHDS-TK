         fhir:Extension.valueString [ fhir:value "AccessLogsResultType" ]
       ] ;
       fhir:ElementDefinition.path [ fhir:value "SEEHDSLMAccessLogV11.accessLogsResultType" ] ;
       fhir:ElementDefinition.short [ fhir:value "Resultatobjekt med status hurvida tjänsten returnerar ok eller om fel uppstått" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Resultatobjekt med status hurvida tjänsten returnerar ok eller om fel uppstått. Om tjänsten utförts korrekt returneras en lista med patientinformation och resultatkod OK. Vid eventuella fel i tjänsteanropet returneras ingen patientinformation. Statuskod som beskriver orsaken till fel returneras då tillsammans med ett felmeddelande." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
