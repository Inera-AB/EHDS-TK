       fhir:ElementDefinition.short [ fhir:value "GetAccessLogsForPatient 1.1" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Logisk modell för version 1.1 av tjänstekontraktet GetAccessLogsForPatient\n(urn:riv:ehr:log:querying:GetAccessLogsForPatientResponder:1).\nMappningen utgår från versionen i SEEHDSLMAccessLog. Skillnaderna mot den och hur de\npåverkar mappningen beskrivs på tjänstekontraktets mappningssida." ]
     ], [
       fhir:index 1 ;
       fhir:Element.id [ fhir:value "SEEHDSLMAccessLogV11.accessLogsResultType" ] ;
       fhir:Element.extension [
         fhir:index 0 ;
