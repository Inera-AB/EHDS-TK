       fhir:ElementDefinition.short [ fhir:value "GetObservations" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Logisk modell för tjänstekontraktet GetObservations\n(RIV-TA urn:riv:clinicalprocess:healthcond:basic:GetObservationsInteraction:2).\nRepresenterar responsens informationsstruktur — en samling observationer som\nmatchar sökkriterier i begäran, inklusive header-information.\nMeddelandemodellen från avsnitt 5.1 V-MIM — Observationer i TKB motsvarar\nen observation i svarsmeddelandet." ]
     ], [
       fhir:index 1 ;
       fhir:Element.id [ fhir:value "SEEHDSLMObservations.observations" ] ;
       fhir:ElementDefinition.path [ fhir:value "SEEHDSLMObservations.observations" ] ;
       fhir:ElementDefinition.short [ fhir:value "De observationer som matchar sökkriterierna, inklusive header." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Kardinalitet: Valfri, lista (0..*) — tomt svar returneras om inga observationer matchar." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "BackboneElement" ]
       ]
     ], [
