       fhir:ElementDefinition.path [ fhir:value "SEEHDSLMObservations.observations.observationBody" ] ;
       fhir:ElementDefinition.short [ fhir:value "Information om en observation (ObservationType)." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Motsvarar klasserna Observation och Uppgift i patientjournal i NI 2017.\nKardinalitet: Obligatorisk (1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
