       fhir:ElementDefinition.short [ fhir:value "Identitet för observationen, unik inom vårdgivaren." ] ;
       fhir:ElementDefinition.definition [ fhir:value "- root: Den informationsägande vårdgivarens HSA-id\n- extension: Den inom vårdgivaren unika id-beteckningen för observationen\nKardinalitet: Obligatorisk (1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
