       fhir:ElementDefinition.short [ fhir:value "NI 2017 (Observation.värde) — det faktiska observerade hälsotillståndet." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Representeras av ValueANYType — en av: cv (CVType/kodat värde), pq (mätvärde),\nivl_pq (intervall), ts (tidpunkt), ivl_ts (tidsintervall), st (fritext), int (heltal).\nKardinalitet: Obligatorisk (1..1)." ] ;
