       fhir:ElementDefinition.path [ fhir:value "SEEHDSLMObservations.observations.observationBody.registrationTime" ] ;
       fhir:ElementDefinition.short [ fhir:value "Dokumentationstidpunkt — när uppgiften registrerades i journalen." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Kan skilja sig från signeringstidpunkt (som återfinns i header).\nKardinalitet: Obligatorisk (1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
