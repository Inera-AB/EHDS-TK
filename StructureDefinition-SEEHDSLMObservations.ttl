       fhir:ElementDefinition.path [ fhir:value "SEEHDSLMObservations.observations.observationBody.value.cv" ] ;
       fhir:ElementDefinition.short [ fhir:value "Kodat värde" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Kodat värde. I fallet med observationer kan det exempelvis vara en diagnoskod enligt ICD-10 eller ett kliniskt fynd enligt Snomed CT." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
