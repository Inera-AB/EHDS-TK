       fhir:ElementDefinition.definition [ fhir:value "Elektronisk adress, t.ex. e-mail eller telefonnummer. Anges i form av en URI inklusive prefix som anger protokoll. Telefonnummer anges med prefixet ”tel:”, e-mailadresser med ”mailto:” och webbsidor med ”http:” eller ”https:”. Exempel: value=”tel:+46702353535” value=”mailto:lars@gmail.com” value=”http://www.1177.se”" ] ;
