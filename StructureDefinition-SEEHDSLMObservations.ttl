       fhir:ElementDefinition.path [ fhir:value "SEEHDSLMObservations.observations.header" ] ;
       fhir:ElementDefinition.short [ fhir:value "Header enligt RIV-TA standard." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Se separat dokument med fältregler för header [R10].\nKardinalitet: Obligatorisk (1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "BackboneElement" ]
       ]
