  fhir:StructureDefinition.differential [
     fhir:StructureDefinition.differential.element [
       fhir:index 0 ;
       fhir:Element.id [ fhir:value "SEEHDSLMCareContactsV20" ] ;
       fhir:ElementDefinition.path [ fhir:value "SEEHDSLMCareContactsV20" ] ;
       fhir:ElementDefinition.short [ fhir:value "GetCareContacts 2.0" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Logisk modell för version 2.0 av tjänstekontraktet GetCareContacts\n(urn:riv:clinicalprocess:logistics:logistics:GetCareContactsResponder:2).\nMappningen utgår från versionen i SEEHDSLMCareContacts. Skillnaderna mot den och hur de\npåverkar mappningen beskrivs på tjänstekontraktets mappningssida." ]
     ], [
       fhir:index 1 ;
       fhir:Element.id [ fhir:value "SEEHDSLMCareContactsV20.careContact" ] ;
       fhir:ElementDefinition.path [ fhir:value "SEEHDSLMCareContactsV20.careContact" ] ;
       fhir:ElementDefinition.short [ fhir:value "De hälso- och sjukvårdskontakter som matchar begäran" ] ;
       fhir:ElementDefinition.definition [ fhir:value "De hälso- och sjukvårdskontakter som matchar begäran." ] ;
