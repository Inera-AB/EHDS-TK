       ] ;
       fhir:ElementDefinition.path [ fhir:value "SEEHDSLMCarePlans.carePlan.carePlanHeader.documentTitle" ] ;
       fhir:ElementDefinition.short [ fhir:value "Rubrik för vård- och omsorgsplanen" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Text som innehåller en rubrik som beskriver innehållet i vård- och omsorgsplanen. För att underlätta för användaren att orientera sig i gränssnittet är det viktigt att ange en deskriptiv text i attributet rubrik. Inga krav finns dock på struktur för detta. Exempel: Samordnad vårdplanering Rehabiliteringsplan." ] ;
