       fhir:ElementDefinition.path [ fhir:value "SEEHDSLMReferralOutcome" ] ;
       fhir:ElementDefinition.short [ fhir:value "GetReferralOutcome" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Logisk modell för tjänstekontraktet GetReferralOutcome\n(RIV-TA urn:riv:clinicalprocess:healthcond:actoutcome:GetReferralOutcome:3).\nRepresenterar responsens informationsstruktur — svar på konsultationsremiss\noch begäran om övertagande av vårdansvar. Meddelandeformatet är kompatibelt\nmed HL7v3 CDA v.2." ]
     ], [
       fhir:index 1 ;
       fhir:Element.id [ fhir:value "SEEHDSLMReferralOutcome.referralOutcome" ] ;
       fhir:ElementDefinition.path [ fhir:value "SEEHDSLMReferralOutcome.referralOutcome" ] ;
       fhir:ElementDefinition.short [ fhir:value "Remissvar (ett per remiss)" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Returnerar en patients konsultationsremissvar." ] ;
