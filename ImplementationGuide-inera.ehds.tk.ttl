       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.inera.se/ig/ehds-tk/StructureDefinition/SEEHDSAllergyIntolerance> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/SEEHDSAllergyIntolerance" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "SE EHDS AllergyIntolerance – Allergi/överkänslighet (GetAlertInformation)" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Sekundär profil för allergier och överkänslighet från GetAlertInformation.\n\nSkapas ENBART när alertInformationBody = hypersensitivity.\nDen tillhörande SEEHDSFlag-resursen är alltid primär och pekar på denna\nresurs via Flag.extension[flag-detail] (standard R4-extension; R5: supportingInfo).\n\nPopuleras med klinisk information från hypersensitivity-blocket:\n- atcSubstance/hypersensitivityAgentCode → AllergyIntolerance.code\n- degreeOfSeverity → AllergyIntolerance.reaction.severity\n- degreeOfCertainty → AllergyIntolerance.verificationStatus (se ALERT-004)\n- ascertainedDate → AllergyIntolerance.onsetDateTime\n- alertInformationComment → AllergyIntolerance.note\n- pharmaceuticalProductId → AllergyIntolerance.reaction.substance.coding (NPL-id)\n\nTäcker NPÖ 2.0 och 1177 Journal 2.0." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 100 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.inera.se/ig/ehds-tk/StructureDefinition/SEEHDSAuditEventPatientRead> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/SEEHDSAuditEventPatientRead" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "SE EHDS AuditEvent – Innehållshämtning med patient (BALP PatientRead)" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Loggpost som ska skapas när ett EHDS-kompatibelt FHIR-API (t.ex. en EHDS-brygga) lämnar ut en\nenskild resurs eller ett dokuments innehåll för en patient, t.ex. läsning av en resurs eller\n(framtida) MHD ITI-68 Retrieve Document. Loggposterna behövs för att patienten ska kunna få\nveta vem som har tagit del av patientens uppgifter.\n\nÄrver från IHE BALP PatientRead och lägger till:\n- användaragent (agent[user]) och syfte (purposeOfEvent, agent[user].purposeOfUse) är obligatoriska\n- en agent per källsystem/vårdgivare som innehållet kommer från (agent[custodian])\n- bryggan som loggkälla (source.observer)" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 101 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.inera.se/ig/ehds-tk/StructureDefinition/SEEHDSAuditEventReadAccessLog> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/SEEHDSAuditEventReadAccessLog" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "SE EHDS AuditEvent – Läsning av åtkomstloggar (GetAccessLogForPatient)" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Profil för att läsa åtkomstloggar: representerar en befintlig loggpost som lämnas ut till\npatienten, mappad från RIVTA-tjänstekontraktet GetAccessLogForPatient\n(informationsecurity:auditing:log v1.1, 2.0). Täcker 1177 Journal 1.1, 2.0. Krävs ej för NPÖ.\n\nProfilen används INTE för att logga användningen av FHIR-API:et. De loggposter som ska skapas\nnär API:et nyttjas beskrivs av SEEHDSAuditEventPatientQuery och SEEHDSAuditEventPatientRead." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 102 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.inera.se/ig/ehds-tk/StructureDefinition/SEEHDSAuditEventPatientQuery> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/SEEHDSAuditEventPatientQuery" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "SE EHDS AuditEvent – Sökning och träfflista med patient (BALP PatientQuery)" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Loggpost som ska skapas när ett EHDS-kompatibelt FHIR-API (t.ex. en EHDS-brygga) tar emot en\nsökning på en patients uppgifter och lämnar ut träfflistan, t.ex. MHD ITI-67 Find Document\nReferences eller QEDm PCC-44. Loggposterna behövs för att patienten ska kunna få veta vem som\nhar tagit del av patientens uppgifter.\n\nÄrver från IHE BALP PatientQuery och lägger till:\n- användaragent (agent[user]) och syfte (purposeOfEvent, agent[user].purposeOfUse) är obligatoriska\n- en agent per källsystem/vårdgivare som bidrog till svaret (agent[custodian])\n- bryggan som loggkälla (source.observer)\n- träfflistan: varje utlämnad resurs registreras som en entity med entity.type = resurstypen\n  (http://hl7.org/fhir/resource-types) och entity.role = object-role#4 \"Domain Resource\"" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 103 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.inera.se/ig/ehds-tk/StructureDefinition/SEEHDSCarePlan> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/SEEHDSCarePlan" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "SE EHDS CarePlan – Vårdplan (GetCarePlans)" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Profil för vård- och omsorgsplaner mappat från RIVTA-tjänstekontraktet GetCarePlans (clinicalprocess:logistics:logistics v2.0). Täcker NPÖ 2.0 och 1177 Journal 2.0." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 104 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.inera.se/ig/ehds-tk/StructureDefinition/SEEHDSCompositionCareDocumentation> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/SEEHDSCompositionCareDocumentation" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "SE EHDS Composition – Strukturerad journalanteckning från DocBook (GetCareDocumentation)" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Valfri strukturerad representation av en journalanteckning från GetCareDocumentation v3.0 när\ninnehållet är DocBook (clinicalDocumentNoteText eller en bilaga med mediaType\napplication/docbook+xml). Varje DocBook-<section> blir en Composition.section med XHTML-narrativ\n(Strategi B, se DOC-004 och sidan DocBook-mappning).\n\nKompletterar SEEHDSDocumentReference, där innehållet alltid finns som XHTML (Strategi A).\nComposition kopplas till DocumentReference genom att samma Provenance har båda i\nProvenance.target." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 105 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.inera.se/ig/ehds-tk/StructureDefinition/SEEHDSConditionDiagnosis> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/SEEHDSConditionDiagnosis" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "SE EHDS Condition – Diagnos (GetDiagnosis)" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Profil för diagnos/problem mappat från RIVTA-tjänstekontraktet GetDiagnosis (clinicalprocess:healthcond:description v2.0). Ärver HL7 Europe Core Condition (EURIDICE). Täcker NPÖ 2.0 och 1177 Journal 2.0." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 106 ;
       fhir:Element.extension [
         fhir:index 0 ;
