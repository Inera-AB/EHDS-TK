       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.inera.se/ig/ehds-tk/StructureDefinition/SEEHDSPractitionerRole> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/SEEHDSPractitionerRole" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "SE EHDS PractitionerRole – Hälso- och sjukvårdspersonal i uppdrag" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Profil för hälso- och sjukvårdspersonal i uppdrag (medarbetaruppdrag) som refereras från\nEHDS-TK-resurserna (t.ex. accountableHealthcareProfessional, legalAuthenticator, author).\nÄrver HL7 Europe Core PractitionerRole (EURIDICE). Identifier-slicen följer svenska basprofilernas\nkonvention (SEBasePractitionerRole: slice hsaid, system urn:oid:1.2.752.29.4.19, typ PRN).\nAnvänds normalt som logisk referens via identifier." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 124 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.inera.se/ig/ehds-tk/StructureDefinition/SEEHDSProvenance> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/SEEHDSProvenance" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "SE EHDS Provenance" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Provenance-profil för EHDS-TK. Varje klinisk resurs åtföljs av en Provenance\nmed två agenter som speglar spärr-hierarkin enligt PDL:\n- custodian (yttre Sparr) — den juridiskt ansvariga vårdgivaren\n- author (inre Sparr) — den informationsägande vårdenheten\n\nOBS: Om den FHIR-server som tillhandahåller data själv hanterar åtkomstfiltrering\nbaserat på anropande vårdpersonals kontext eller patientens e-hälsotjänst, behöver\nProvenance-agenterna för spärr och `meta.security` för `approvedForPatient` inte\ninkluderas i svaret — filtreringen sker då redan på servernivå." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
