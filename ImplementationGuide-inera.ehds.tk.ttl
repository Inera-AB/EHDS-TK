       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "SE EHDS ImagingStudy – Bilddiagnostik (GetImagingOutcome)" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Profil för bilddiagnostiska undersökningar mappat från RIVTA-tjänstekontraktet GetImagingOutcome (clinicalprocess:healthcond:actoutcome v1.0). Täcker NPÖ 1.0 och 1177 Journal 1.0." ] ;
