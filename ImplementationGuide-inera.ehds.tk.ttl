       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Profil för bilddiagnostiska utlåtanden/fynd från GetImagingOutcome. Används tillsammans med SEEHDSImagingStudy för att representera både undersökning och svar." ] ;
