       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.inera.se/ig/ehds-tk/CapabilityStatement/SEEHDSResourceAccessProvider> ;
         fhir:Reference.reference [ fhir:value "CapabilityStatement/SEEHDSResourceAccessProvider" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "SE EHDS Resource Access Provider" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Krav på ett FHIR-API som tillhandahåller data från RIVTA-tjänstekontrakten enligt denna IG.\nBygger på EURIDICE (EU Health Data API) Resource Access Provider och anger vilka profiler i\ndenna IG som resurserna ska följa." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
