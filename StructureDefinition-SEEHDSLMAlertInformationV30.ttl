       ] ;
       fhir:ElementDefinition.path [ fhir:value "SEEHDSLMAlertInformationV30.alertInformation.header.accessControlHeader.blockComparisonTime" ] ;
       fhir:ElementDefinition.short [ fhir:value "Den tidpunkt mot vilken spärrkontroll sker vid åtkomst med syftet sammanhållen journalföring för kontroll av …" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Den tidpunkt mot vilken spärrkontroll sker vid åtkomst med syftet sammanhållen journalföring för kontroll av patientens (ev.) spärrade information, såväl yttre (mellan vårdgivare) som inre (mellan vårdenheter) spärr. Vad som sätts i blockComparisonTime beror på vilken typ av uppmärksamhetsinformation som anges enligt följande: Hypersensitivity body/hypersensitivity/time/ timestamp eller body/hypersensitivity/time/ timePeriod/start activity body/activity/time/timestamp eller body/activity/time/timePeriod/start condition body/condition/time/timestamp eller body/condition/time/timePeriod/start decisionNonstandardCareProcedure body/decisionNonstandard CareProcedure/time/timestamp informationNonstandardCareProcedure body/informationNonstandard CareProcedure/time/timestamp eller body/informationNonstandard CareProcedure/time/timePeriod/start Contagion body/contagion/time/timestamp eller body/contagion/time/timePeriod/start unstructuredAlertInformation header/record/timestamp\nFormat enligt XSD (TimeStampType): ÅÅÅÅMMDDttmmss." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "SEEHDSLMAlertInformationV30.alertInformation.header.accessControlHeader.blockComparisonTime" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
