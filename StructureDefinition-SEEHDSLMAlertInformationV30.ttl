  fhir:StructureDefinition.differential [
     fhir:StructureDefinition.differential.element [
       fhir:index 0 ;
       fhir:Element.id [ fhir:value "SEEHDSLMAlertInformationV30" ] ;
       fhir:ElementDefinition.path [ fhir:value "SEEHDSLMAlertInformationV30" ] ;
       fhir:ElementDefinition.short [ fhir:value "GetAlertInformation 3.0" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Logisk modell för version 3.0 av tjänstekontraktet GetAlertInformation\n(urn:riv:clinicalprocess:healthcond:description:GetAlertInformationResponder:3).\nMappningen utgår från versionen i SEEHDSLMAlertInformation. Skillnaderna mot den och hur de\npåverkar mappningen beskrivs på tjänstekontraktets mappningssida." ]
     ], [
       fhir:index 1 ;
       fhir:Element.id [ fhir:value "SEEHDSLMAlertInformationV30.alertInformation" ] ;
       fhir:ElementDefinition.path [ fhir:value "SEEHDSLMAlertInformationV30.alertInformation" ] ;
       fhir:ElementDefinition.short [ fhir:value "Den uppmärksamhetsinformation som matchar begäran" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Den uppmärksamhetsinformation som matchar begäran." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "BackboneElement" ]
       ]
     ], [
       fhir:index 2 ;
       fhir:Element.id [ fhir:value "SEEHDSLMAlertInformationV30.alertInformation.header" ] ;
       fhir:ElementDefinition.path [ fhir:value "SEEHDSLMAlertInformationV30.alertInformation.header" ] ;
       fhir:ElementDefinition.short [ fhir:value "JoL-header" ] ;
       fhir:ElementDefinition.definition [ fhir:value "JoL-header. Innehåller metainformation som är gemensam för patientjournalinformation, exempelvis uppgift om vilken hälso- och sjukvårdspersonal som är angiven som författare av informationen och information om signering." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "BackboneElement" ]
       ]
     ], [
       fhir:index 3 ;
       fhir:Element.id [ fhir:value "SEEHDSLMAlertInformationV30.alertInformation.header.accessControlHeader" ] ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/elementdefinition-namespace" ] ;
         fhir:Extension.valueUri [ fhir:value "urn:riv:clinicalprocess:healthcond:description:3" ]
       ] ;
       fhir:ElementDefinition.path [ fhir:value "SEEHDSLMAlertInformationV30.alertInformation.header.accessControlHeader" ] ;
       fhir:ElementDefinition.short [ fhir:value "Information för kontroll av åtkomst" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Information för kontroll av åtkomst. Syftet med denna del av headern är att den ska innehålla den information som behövs för konsumentens filtrering av informationen innan den visas upp för slutanvändaren eller på annat vis behandlas vidare, exempelvis för kontroll av spärrar (avseende vårdpersonals åtkomst till information; PDL) eller om informationen får visas för patienten eller inte (verksamhetens rätt till rådrum och menprövning). En konsument (en konsumerande tjänst/applikation) har inte rätt att ta del av något annat än innehållet i accessControlHeader innan de för ändamålet nödvändiga säkerhetskontrollerna har utförts." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "BackboneElement" ]
       ]
     ], [
       fhir:index 4 ;
       fhir:Element.id [ fhir:value "SEEHDSLMAlertInformationV30.alertInformation.header.accessControlHeader.accountableHealthcareProvider" ] ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/elementdefinition-namespace" ] ;
         fhir:Extension.valueUri [ fhir:value "urn:riv:clinicalprocess:healthcond:description:3" ]
       ] ;
       fhir:ElementDefinition.path [ fhir:value "SEEHDSLMAlertInformationV30.alertInformation.header.accessControlHeader.accountableHealthcareProvider" ] ;
       fhir:ElementDefinition.short [ fhir:value "Id för informationsägande vårdgivare" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Id för informationsägande vårdgivare. I första hand HSAid alternativt i andra hand organisationsnummer. Om HSA-id används sätts fältet root till oid för HSA-katalogen (1.2.752.129.2.1.4.1) och fältet extension sätts till HSA-id. Om organisationsnummer används skall fältet root sättas till OID för organisationsnummer (1.2.752.29.4.3) och fältet extension sättas till organisationsnumret. Enskild näringsidkare har i rollen som juridisk person sitt personnummer som organisationsnummer. Se även regel Spärrhantering." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/ehds-tk/StructureDefinition/SEEHDSRivIITypeHealthcondDescription3" ]
       ]
     ], [
       fhir:index 5 ;
       fhir:Element.id [ fhir:value "SEEHDSLMAlertInformationV30.alertInformation.header.accessControlHeader.accountableCareUnit" ] ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/elementdefinition-namespace" ] ;
         fhir:Extension.valueUri [ fhir:value "urn:riv:clinicalprocess:healthcond:description:3" ]
       ] ;
       fhir:ElementDefinition.path [ fhir:value "SEEHDSLMAlertInformationV30.alertInformation.header.accessControlHeader.accountableCareUnit" ] ;
       fhir:ElementDefinition.short [ fhir:value "Id för informationsägande vårdenhet angivet med HSA-id" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Id för informationsägande vårdenhet angivet med HSA-id. Fältet root sätts OID för HSA-katalogen (1.2.752.129.2.1.4.1) och fältet extension sätts till HSA-id. Fältet används för spärrkontroll och är obligatorisk om uppgiften i patientjournal ska kunna ses via sammanhållen journalföring. Se även regel Spärrhantering." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/ehds-tk/StructureDefinition/SEEHDSRivIITypeHealthcondDescription3" ]
       ]
     ], [
       fhir:index 6 ;
       fhir:Element.id [ fhir:value "SEEHDSLMAlertInformationV30.alertInformation.header.accessControlHeader.patientId" ] ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/elementdefinition-namespace" ] ;
         fhir:Extension.valueUri [ fhir:value "urn:riv:clinicalprocess:healthcond:description:3" ]
       ] ;
       fhir:ElementDefinition.path [ fhir:value "SEEHDSLMAlertInformationV30.alertInformation.header.accessControlHeader.patientId" ] ;
       fhir:ElementDefinition.short [ fhir:value "Patientens identitetsbeteckning" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Patientens identitetsbeteckning. Den identitetsbeteckning som denna uppgift lagrades under när uppgiften skapades ska om möjligt anges. Exempel på en situation då detta förekommer är exempelvis då patienten tidigare erhållit vård dokumenterat under ett samordningsnummer för att sedan bli folkbokförd i Sverige och få ett personnummer. Fältet root sätts till OID för kodverket för identifieraren: 1) För personnummer skall Skatteverkets OID för personnummer (1.2.752.129.2.1.3.1) användas. 2) För samordningsnummer skall Skatteverkets OID för samordningsnummer (1.2.752.129.2.1.3.3) användas. Fältet extension sätts till patientens identifierare. Anges med 12 tecken utan avskiljare." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/ehds-tk/StructureDefinition/SEEHDSRivIITypeHealthcondDescription3" ]
       ]
     ], [
       fhir:index 7 ;
       fhir:Element.id [ fhir:value "SEEHDSLMAlertInformationV30.alertInformation.header.accessControlHeader.careProcessId" ] ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/elementdefinition-namespace" ] ;
         fhir:Extension.valueUri [ fhir:value "urn:riv:clinicalprocess:healthcond:description:3" ]
       ] ;
       fhir:ElementDefinition.path [ fhir:value "SEEHDSLMAlertInformationV30.alertInformation.header.accessControlHeader.careProcessId" ] ;
       fhir:ElementDefinition.short [ fhir:value "Id för den individanpassad vårdprocess som informationen journalförts inom ramen för" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Id för den individanpassad vårdprocess som informationen journalförts inom ramen för. Består av ett lokalt genererat UUID. UUID anges i root och extension lämnas tomt." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/ehds-tk/StructureDefinition/SEEHDSRivIITypeHealthcondDescription3" ]
       ]
     ], [
       fhir:index 8 ;
       fhir:Element.id [ fhir:value "SEEHDSLMAlertInformationV30.alertInformation.header.accessControlHeader.blockComparisonTime" ] ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/elementdefinition-namespace" ] ;
         fhir:Extension.valueUri [ fhir:value "urn:riv:clinicalprocess:healthcond:description:3" ]
       ] ;
       fhir:ElementDefinition.path [ fhir:value "SEEHDSLMAlertInformationV30.alertInformation.header.accessControlHeader.blockComparisonTime" ] ;
       fhir:ElementDefinition.short [ fhir:value "Den tidpunkt mot vilken spärrkontroll sker vid åtkomst med syftet sammanhållen journalföring för kontroll av …" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Den tidpunkt mot vilken spärrkontroll sker vid åtkomst med syftet sammanhållen journalföring för kontroll av patientens (ev.) spärrade information, såväl yttre (mellan vårdgivare) som inre (mellan vårdenheter) spärr. Vad som sätts i blockComparisonTime beror på vilken typ av uppmärksamhetsinformation som anges enligt följande: Hypersensitivity body/hypersensitivity/time/ timestamp eller body/hypersensitivity/time/ timePeriod/start activity body/activity/time/timestamp eller body/activity/time/timePeriod/start condition body/condition/time/timestamp eller body/condition/time/timePeriod/start decisionNonstandardCareProcedure body/decisionNonstandard CareProcedure/time/timestamp informationNonstandardCareProcedure body/informationNonstandard CareProcedure/time/timestamp eller body/informationNonstandard CareProcedure/time/timePeriod/start Contagion body/contagion/time/timestamp eller body/contagion/time/timePeriod/start unstructuredAlertInformation header/record/timestamp\nFormat enligt XSD (TimeStampType): ÅÅÅÅMMDDttmmss." ] ;
