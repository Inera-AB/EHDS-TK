       fhir:ElementDefinition.short [ fhir:value "Obligatoriskt om clinicalDocumentNoteCode saknas" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Obligatoriskt om clinicalDocumentNoteCode saknas. Får annars inte anges samtidigt med clinicalDocumentNoteCode. Epikris = epi Intagninganteckning = int Daganteckning = dag Öppenvårdsanteckning = ova Öppenvårdssammanfattning = ovs Övrigt document = ovr\nTillåtna värden enligt XSD: epi, int, dag, ova, ovs, ovr." ] ;
