       fhir:ElementDefinition.definition [ fhir:value "Typ av PADL-bedömning. Kan anges med lämpligt kodsystem för PADL.\nKardinalitet: Obligatorisk.\nRegel 2 (TKB): Då attributet avser Personlig ADL ska ENBART ett av följande värden anges per post: 'personlig hygien', 'på/avklädning', 'förflyttning', 'toalettbesök', 'födointag'." ] ;
