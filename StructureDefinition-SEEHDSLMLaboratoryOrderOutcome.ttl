         fhir:Extension.valueUri [ fhir:value "urn:riv:clinicalprocess:healthcond:actoutcome:4" ]
       ] ;
       fhir:ElementDefinition.path [ fhir:value "SEEHDSLMLaboratoryOrderOutcome.laboratoryOrderOutcome.header.record.timestamp" ] ;
       fhir:ElementDefinition.short [ fhir:value "Tidpunkt för posten" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Den tidpunkt då uppgiften skapades i tjänsteproducentens källsystem. Denna information ska vara beständig även om tjänsteproducenten migrerat uppgiften från ett källsystem till en annat. Motsvarar Laboratoriesvar.svarstidpunkt i informationsspecifikationen [R6]\nFormat enligt XSD (TimeStampType): ÅÅÅÅMMDDttmmss." ] ;
