       fhir:ElementDefinition.short [ fhir:value "Tidpunkt för dokumentation" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Tidpunkt då uppgiften dokumenterades eller senast uppdaterades. I de fall då uppgiften ursprungligen dokumenterats eller uppdaterats i ett annat informationssystem än tjänsteproducentens källsystem (t.ex. laboratorieinformationssystem), ska tidpunkten spegla informationen från systemet där uppgiften ursprungligen dokumenterades.\nFormat enligt XSD (TimeStampType): ÅÅÅÅMMDDttmmss." ] ;
