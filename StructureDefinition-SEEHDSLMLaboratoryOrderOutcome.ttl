       fhir:ElementDefinition.path [ fhir:value "SEEHDSLMLaboratoryOrderOutcome.laboratoryOrderOutcome.header.signature" ] ;
       fhir:ElementDefinition.short [ fhir:value "Signatär" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Information avseende signering av laboratoriesvaret. Laboratoriesvaret signeras av en medicinskt ansvarig hälso- och sjukvårdspersonal på den ansvariga enheten. Den ansvariga enheten kan vara den remissmottagande enheten eller den utförande enheten (exempelvis vid patientnära analyser)." ] ;
