       ] ;
       fhir:ElementDefinition.path [ fhir:value "SEEHDSLMLaboratoryOrderOutcome.laboratoryOrderOutcome.header.author.byRole" ] ;
       fhir:ElementDefinition.short [ fhir:value "Yrkesroll vid dokumentation" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Information om hälso- och sjukvårdspersonalens befattning så som den var angiven i HSA-katalogen vid dokumentationstidpunkten. Anges med HSAs kodverk Befattning (OID: 1.2.752.129.2.2.1.4). Om kod inte är tillgänglig anges befattning som klartext i datatypens attribut originalText." ] ;
