       fhir:ElementDefinition.short [ fhir:value "Ordinationsstatus (Active/Inactive)" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Ordinationsstatus. Anger ordinationens aktuella status [Active, Inactive] En aktiv ordination är den sista i sin ordinationskedja. Alla andra ordinationer i samma ordinationskedja är inaktiva.\nTillåtna värden enligt XSD: Active, Inactive." ] ;
