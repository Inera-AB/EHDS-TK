       fhir:ElementDefinition.short [ fhir:value "Varunummer (från SIL)" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Varunummer. Från SIL. Identifierare för ordinerad handelsvara (exempel: spruta). Bör anges med id ur Apotekets varunummerregister. OID: 1.2.752.129.2.2.3.1.1. Får ej anges för läkemedel.\nEnligt TKB i detta sammanhang: code 1..1, codeSystem 1..1, displayName 1..1, originalText 0..0." ] ;
