       fhir:ElementDefinition.short [ fhir:value "Doseringsenhet" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Doseringsenhet. Kod som anger den enhet som doseringen avser. Exempel: tablett, ml, droppe I dagsläget existerar ingen kvalitetssäkrad kodifierad förteckning över doseringsenheter, men kan anges med SNOMED-kod. Via SIL kan doseringsenhet som text erhållas för vissa läkemedel." ] ;
