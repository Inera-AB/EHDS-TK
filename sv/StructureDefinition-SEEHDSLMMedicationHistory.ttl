         fhir:ElementDefinition.constraint.human [ fhir:value "startOfTreatment ska anges om typeOfPrescription är I" ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "typeOfPrescription.value != 'I' or startOfTreatment.exists()" ] ;
         fhir:ElementDefinition.constraint.source [
